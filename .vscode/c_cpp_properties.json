{
    "configurations": [
        {
            "name": "Windows",
            "compilerPath": "g++.exe",
            "intelliSenseMode": "windows-gcc-x64",
            "cStandard": "c99",
            "cppStandard": "c++17",
            "includePath": [
                "${workspaceFolder}/include",
                "${workspaceFolder}/include/core",
                "${workspaceFolder}/include/gfx",
                "${workspaceFolder}/include/world",
                "${workspaceFolder}/include/entities",
                "${workspaceFolder}/include/civ",
                "${workspaceFolder}/build/deps/raylib/src"
            ]
        },
        {
            "name": "Mac",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/include",
                "/opt/homebrew/include",
                "/usr/local/include"
            ],
            "defines": [],
            "macFrameworkPath": [
                "/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/System/Library/Frameworks"
            ],
            "compilerPath": "/usr/bin/clang++",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "macos-clang-arm64"
        }
    ],
    "version": 4
}
